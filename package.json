{
  "name": "roblox-2016-reborn",
  "version": "1.0.0",
  "private": true,
  "description": "Independent 2016-inspired community portal with accounts and an Electron launcher",
  "main": "launcher/main.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "launcher": "electron .",
    "launcher:pack": "electron-builder --win nsis"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "connect-sqlite3": "^0.9.13",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "express-session": "^1.18.1",
    "helmet": "^8.0.0",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.reborn.roblox2016.launcher",
    "productName": "Roblox 2016 Reborn",
    "directories": { "output": "dist-launcher" },
    "files": ["launcher/**/*", "package.json"],
    "win": { "target": "nsis" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  }
}